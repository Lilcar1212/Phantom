# Copy to .env (install.ps1 does this). .env is git-ignored. Never paste these values into chat.

# Solana RPC endpoint, e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SURVIVOR_RPC_URL=

# Wallet keys are NOT stored here by default: milestone 2 stores the burner key
# encrypted with Windows DPAPI under data\. Only use a plain-text key in this
# file if you explicitly choose that option during wallet setup.
